#!/usr/bin/env bash
# Canonical acceptance gate for the AppMate hermes-agent fork.
#
# v0.20.4 (v2026.8.18) integration: the release-base bootstrap list (model
# metadata, config validation, background review, compression/compaction,
# hermes_state and FTS, gateway session/completion/hygiene/delivery, Buzz)
# plus every AppMate test file that proves a ported production capability
# (transactional in-place compaction, request admission ownership, completion
# provenance, desktop loopback auth, turn-context provenance). Every file
# listed here exists on this branch and collects inside the credential-free
# verifier image declared in .argus/verifier.json. Extend it with the tests
# that prove each new behaviour; do not remove entries without an explicit
# reason.
#
# Runs through the repository's hermetic per-file runner (clean env, TZ=UTC,
# per-file subprocess isolation). Retries are controlled by
# HERMES_TEST_FILE_RETRIES; the verifier passes 0 so flakiness is visible.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

exec "$repo_root/scripts/run_tests.sh" \
  tests/agent/test_model_metadata.py \
  tests/hermes_cli/test_config.py \
  tests/hermes_cli/test_config_validation.py \
  tests/hermes_cli/test_config_loader_e2e.py \
  tests/hermes_cli/test_update_config_clears_custom_fields.py \
  tests/agent/test_background_review_usage.py \
  tests/agent/test_skip_background_review.py \
  tests/run_agent/test_background_review.py \
  tests/run_agent/test_background_review_cost_controls.py \
  tests/test_background_review_session_isolation.py \
  tests/agent/test_compaction_anti_thrash.py \
  tests/agent/test_compress_context_progress_timeout.py \
  tests/agent/test_compression_review_76354.py \
  tests/agent/test_compression_adoption_preserves_live_tail.py \
  tests/agent/test_compression_anti_thrash_persistence.py \
  tests/agent/test_compression_anti_thrash_recovery.py \
  tests/agent/test_compression_concurrent_fork.py \
  tests/agent/test_context_compressor.py \
  tests/run_agent/test_compression_persistence.py \
  tests/run_agent/test_in_place_compaction.py \
  tests/run_agent/test_pre_compress_memory_context.py \
  tests/run_agent/test_413_compression.py \
  tests/cli/test_manual_compress.py \
  tests/cli/test_compress_here.py \
  tests/cli/test_compress_type_ahead.py \
  tests/gateway/test_compress_command.py \
  tests/tui_gateway/test_compress_lock_skip.py \
  tests/test_hermes_state.py \
  tests/test_hermes_state_compression_locks.py \
  tests/test_hermes_state_compression_busy_retry.py \
  tests/state/test_fts_runtime_rebuild.py \
  tests/test_fts_update_of_narrowing.py \
  tests/gateway/test_session_hygiene.py \
  tests/gateway/test_hygiene_failure_cooldown_ladder.py \
  tests/gateway/test_session_race_guard.py \
  tests/gateway/test_wake_delivery.py \
  tests/gateway/test_completion_delivery.py \
  tests/gateway/test_completion_session_boundary.py \
  tests/gateway/test_restart_redelivery_dedup.py \
  tests/gateway/test_delivery_ledger.py \
  tests/gateway/test_delivery_ledger_producer.py \
  tests/gateway/test_api_server.py \
  tests/gateway/test_session_reset_notify.py \
  tests/gateway/test_buzz_adapter.py \
  tests/gateway/test_buzz_websocket.py \
  tests/agent/test_completion_chain_compaction.py \
  tests/agent/test_request_admission_ownership.py \
  tests/tui_gateway/test_completion_provenance.py \
  tests/run_agent/test_partial_compression_atomicity.py \
  tests/hermes_cli/test_desktop_loopback_auth.py \
  tests/agent/test_turn_context.py \
  -o 'addopts=' -q
